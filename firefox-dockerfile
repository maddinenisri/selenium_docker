# Base image: Maven with Temurin 21
FROM maven:3.9.9-eclipse-temurin-21

# Firefox and Geckodriver Versions
ARG FIREFOX_VERSION=138.0.4
ARG GECKODRIVER_VERSION=0.36.0

# Chrome and ChromeDriver Versions
ARG CHROME_VERSION=136.0.7103.92-1
ARG CHROME_DRIVER_VERSION=136.0.7103.92

# Fix GPG key issues for Debian repositories
RUN apt-get update -qqy || true && \
    apt-get install -qqy --no-install-recommends gnupg2 ca-certificates && \
    apt-key adv --keyserver keyserver.ubuntu.com --recv-keys 0E98404D386FA1D9 && \
    apt-key adv --keyserver keyserver.ubuntu.com --recv-keys 6ED0E7B82643E131 && \
    apt-key adv --keyserver keyserver.ubuntu.com --recv-keys F8D2585B8783D481 && \
    apt-key adv --keyserver keyserver.ubuntu.com --recv-keys 54404762BBB6E853 && \
    apt-key adv --keyserver keyserver.ubuntu.com --recv-keys BDE6D2B9216EC7A8

# Install essential packages for Firefox in headless mode
RUN apt-get update -qqy \
    && apt-get install -qqy --no-install-recommends \
    wget \
    curl \
    bzip2 \
    unzip \
    xvfb \
    xz-utils \
    # Audio packages
    libasound2t64 \
    libasound2-dev \
    # PCI utilities (fixes libpci missing error)
    pciutils \
    # Graphics and X11 related packages
    mesa-utils \
    libgl1-mesa-dri \
    libgl1 \
    libglx-mesa0 \
    # Minimal set of Firefox dependencies
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libnss3 \
    libxss1 \
    libgbm1 \
    libgl1 \
    libfontconfig1 \
    libfreetype6 \
    libpng16-16 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxrender1 \
    libharfbuzz0b \
    libevent-2.1-7 \
    libffi8 \
    procps \
    dbus-x11 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libglib2.0-0 \
    libsoup2.4-1 \
    fonts-liberation \
    fonts-dejavu \
    libdbus-1-3 \
    libegl1 \
    libxcb-xinput0 \
    libpulse0 \
    libvulkan1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Install Chrome
RUN apt-get update -qqy && apt-get install -qqy wget curl gnupg unzip ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update -qqy \
    && apt-get install -qqy google-chrome-stable=${CHROME_VERSION} \
    && rm /etc/apt/sources.list.d/google-chrome.list \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
    && sed -i 's|"$HERE/chrome"|"$HERE/chrome" --no-sandbox|g' /opt/google/chrome/google-chrome


# Install ChromeDriver
RUN wget -q -O /tmp/chromedriver.zip https://storage.googleapis.com/chrome-for-testing-public/${CHROME_DRIVER_VERSION}/linux64/chromedriver-linux64.zip \
    && unzip /tmp/chromedriver.zip -d /opt \
    && rm /tmp/chromedriver.zip \
    && ln -s /opt/chromedriver-linux64/chromedriver /usr/bin/chromedriver

# Manually install libasound2t64 (as suggested by user)
RUN wget -q http://mirrors.edge.kernel.org/ubuntu/pool/main/a/alsa-lib/libasound2_1.2.4-1.1ubuntu2_amd64.deb -O libasound2t64.deb || true && \
    if [ -f libasound2t64.deb ]; then \
    apt-get update && \
    apt-get install -y ./libasound2t64.deb || true; \
    fi && \
    rm -f ./*.deb

# Manually install libgconf-2-4 and its dependencies with the latest versions
RUN wget -q http://mirrors.edge.kernel.org/ubuntu/pool/universe/g/gconf/gconf2-common_3.2.6-7ubuntu2_all.deb && \
    wget -q http://mirrors.edge.kernel.org/ubuntu/pool/universe/g/gconf/libgconf-2-4_3.2.6-7ubuntu2_amd64.deb && \
    apt-get update && \
    apt-get install -y ./gconf2-common_3.2.6-7ubuntu2_all.deb ./libgconf-2-4_3.2.6-7ubuntu2_amd64.deb || true && \
    rm -f ./*.deb

# Install Firefox
# Download the specific Firefox version for Linux 64-bit from the FTP server
RUN wget -q -O /tmp/firefox.tar.xz "https://ftp.mozilla.org/pub/firefox/releases/${FIREFOX_VERSION}/linux-x86_64/en-US/firefox-${FIREFOX_VERSION}.tar.xz" \
    && tar -xJf /tmp/firefox.tar.xz -C /opt/ \
    && rm /tmp/firefox.tar.xz \
    # Create a symlink to the firefox executable for easy access
    && ln -s /opt/firefox/firefox /usr/bin/firefox \
    # Ensure Firefox has proper permissions
    && chmod -R 755 /opt/firefox

# Install Geckodriver
# Download the specific Geckodriver version for Linux 64-bit from GitHub releases
RUN wget -q -O /tmp/geckodriver.tar.gz "https://github.com/mozilla/geckodriver/releases/download/v${GECKODRIVER_VERSION}/geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz" \
    && tar -xzf /tmp/geckodriver.tar.gz -C /tmp/ \
    && mv /tmp/geckodriver /usr/local/bin/geckodriver \
    && rm /tmp/geckodriver.tar.gz \
    # Make the geckodriver executable
    && chmod +x /usr/local/bin/geckodriver

# Create a directory for Firefox cache and give it proper permissions
RUN mkdir -p /tmp/.mozilla \
    && chmod 777 /tmp/.mozilla

# Create Firefox preferences to improve stability in headless mode
RUN mkdir -p /etc/firefox && \
    echo 'pref("gfx.x11-egl.force-enabled", false);' >> /etc/firefox/syspref.js && \
    echo 'pref("widget.use-xdg-desktop-portal", false);' >> /etc/firefox/syspref.js && \
    echo 'pref("browser.tabs.remote.autostart", false);' >> /etc/firefox/syspref.js && \
    echo 'pref("layers.acceleration.disabled", true);' >> /etc/firefox/syspref.js

# Create scripts as root before switching to appuser
# Create a script to run tests with Xvfb
RUN echo '#!/bin/bash\nxvfb-run -a --server-args="-screen 0 1920x1080x24" "$@"' > /usr/local/bin/xvfb-run-safe \
    && chmod +x /usr/local/bin/xvfb-run-safe

# Create a more robust Xvfb startup script
RUN echo '#!/bin/bash\n\
    # Start Xvfb\n\
    Xvfb :99 -screen 0 1920x1080x24 -ac &\n\
    XVFB_PID=$!\n\
    \n\
    # Wait for Xvfb to be ready\n\
    sleep 2\n\
    \n\
    # Run the command\n\
    "$@"\n\
    EXIT_CODE=$?\n\
    \n\
    # Kill Xvfb\n\
    kill $XVFB_PID\n\
    \n\
    # Return the command exit code\n\
    exit $EXIT_CODE' > /usr/local/bin/with-xvfb \
    && chmod +x /usr/local/bin/with-xvfb

# Copy the test runner scripts
COPY run-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

COPY harness-run-tests.sh /usr/local/bin/harness-run-tests.sh
RUN chmod +x /usr/local/bin/harness-run-tests.sh

# Environment Variables
# Set the paths to the Chrome binary and Chromedriver binary
ENV CHROME_BIN=/usr/bin/google-chrome
ENV CHROMEDRIVER_BIN=/usr/bin/chromedriver

# Set the paths to the Firefox binary and Geckodriver binary
ENV FIREFOX_BIN=/usr/bin/firefox
ENV GECKODRIVER_BIN=/usr/local/bin/geckodriver
# Explicitly enable headless mode for Firefox
ENV MOZ_HEADLESS=1
# Set display for Xvfb (if needed)
ENV DISPLAY=:99
# Set Firefox preferences for Docker environment
ENV MOZ_FORCE_DISABLE_E10S=1
ENV MOZ_DISABLE_CONTENT_SANDBOX=1
ENV MOZ_DISABLE_GMP_SANDBOX=1
ENV MOZ_DISABLE_RDD_SANDBOX=1
ENV MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
ENV MOZ_DISABLE_UTILITY_SANDBOX=1
# Disable Firefox crash reporter in headless mode
ENV MOZ_CRASHREPORTER_DISABLE=1
# Set locale variables for better compatibility
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
# Disable hardware acceleration for Firefox
ENV MOZ_WEBRENDER=0
ENV MOZ_ACCELERATED=0

# Create non-root user
RUN useradd -m appuser
USER appuser
WORKDIR /home/appuser

# Expose the default port for Geckodriver
EXPOSE 4444

# No CMD directive - Harness will execute mvn clean test directly
