# Use Maven with Temurin 21 (Debian Bookworm base)
FROM maven:3.9.9-eclipse-temurin-21

# Arguments for versions
ARG FIREFOX_VERSION=138.0.4
ARG GECKODRIVER_VERSION=0.36.0

# Install dependencies
RUN apt-get update -qqy && \
    apt-get install -qqy --no-install-recommends \
    ca-certificates \
    gnupg \
    wget \
    curl \
    bzip2 \
    unzip \
    xvfb \
    xz-utils \
    apt-utils \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libxtst6 \
    libnss3 \
    libxss1 \
    libgbm1 \
    libgl1 \
    libfontconfig1 \
    libfreetype6 \
    libjpeg-turbo8 \
    libpng16-16 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxrender1 \
    libharfbuzz0b \
    libevent-2.1-7 \
    libffi8 \
    procps \
    dbus-x11 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libx11-xcb1 \
    libdrm2 \
    libglib2.0-0 \
    libsoup2.4-1 \
    fonts-liberation \
    fonts-dejavu \
    libasound2 \
    libdbus-1-3 \
    libnss3-tools \
    strace \
    locales \
    tzdata \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify libasound.so.2 is present
RUN ldconfig && \
    echo "Verifying libasound.so.2 presence:" && \
    find / -name libasound.so.2 2>/dev/null || echo "libasound.so.2 not found after install!"

# Install Firefox
RUN wget -q -O /tmp/firefox.tar.xz "https://ftp.mozilla.org/pub/firefox/releases/${FIREFOX_VERSION}/linux-x86_64/en-US/firefox-${FIREFOX_VERSION}.tar.xz" && \
    tar -xJf /tmp/firefox.tar.xz -C /opt/ && \
    rm /tmp/firefox.tar.xz && \
    ln -s /opt/firefox/firefox /usr/bin/firefox && \
    chmod -R 755 /opt/firefox

# Install Geckodriver
RUN wget -q -O /tmp/geckodriver.tar.gz "https://github.com/mozilla/geckodriver/releases/download/v${GECKODRIVER_VERSION}/geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz" && \
    tar -xzf /tmp/geckodriver.tar.gz -C /tmp/ && \
    mv /tmp/geckodriver /usr/local/bin/geckodriver && \
    rm /tmp/geckodriver.tar.gz && \
    chmod +x /usr/local/bin/geckodriver

# Create a directory for Firefox cache and give it proper permissions
RUN mkdir -p /tmp/.mozilla && chmod 777 /tmp/.mozilla

# Environment variables
ENV FIREFOX_BIN=/usr/bin/firefox
ENV GECKODRIVER_BIN=/usr/local/bin/geckodriver
ENV MOZ_HEADLESS=1
ENV DISPLAY=:99
ENV MOZ_CRASHREPORTER_DISABLE=1
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib:${LD_LIBRARY_PATH}
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

# Create non-root user for running tests
RUN useradd -m appuser
USER appuser
WORKDIR /home/appuser

# Expose Geckodriver port (if using remote WebDriver)
EXPOSE 4444

# Add a script to run tests with Xvfb
RUN echo '#!/bin/bash\nxvfb-run -a --server-args="-screen 0 1920x1080x24" "$@"' > /usr/local/bin/xvfb-run-safe \
    && chmod +x /usr/local/bin/xvfb-run-safe \
    && echo "Testing Firefox with libasound.so.2:" \
    && ldd /opt/firefox/libxul.so | grep asound || echo "libasound.so.2 not found in ldd output!"

# Create a more robust Xvfb startup script
RUN echo '#!/bin/bash\n\
    # Start Xvfb\n\
    Xvfb :99 -screen 0 1920x1080x24 -ac &\n\
    XVFB_PID=$!\n\
    \n\
    # Wait for Xvfb to be ready\n\
    sleep 2\n\
    \n\
    # Run the command\n\
    "$@"\n\
    EXIT_CODE=$?\n\
    \n\
    # Kill Xvfb\n\
    kill $XVFB_PID\n\
    \n\
    # Return the command exit code\n\
    exit $EXIT_CODE' > /usr/local/bin/with-xvfb \
    && chmod +x /usr/local/bin/with-xvfb

# Copy the test runner scripts
COPY run-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

COPY harness-run-tests.sh /usr/local/bin/harness-run-tests.sh
RUN chmod +x /usr/local/bin/harness-run-tests.sh

# No CMD directive - Harness will execute mvn clean test directly
