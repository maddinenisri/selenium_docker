# Base image: Maven with Temurin 21 (Debian-based)
FROM maven:3.9.9-eclipse-temurin-21

# Browser and Driver Versions
ARG FIREFOX_VERSION=138.0.4
ARG GECKODRIVER_VERSION=0.36.0
ARG CHROME_VERSION=136.0.7103.92-1
ARG CHROME_DRIVER_VERSION=136.0.7103.92

# Fix GPG key issues for Debian repositories and update apt cache
# This block ensures apt can correctly fetch and verify packages
RUN echo "deb http://deb.debian.org/debian/ bookworm main contrib non-free" > /etc/apt/sources.list \
    && echo "deb http://deb.debian.org/debian/ bookworm-updates main contrib non-free" >> /etc/apt/sources.list \
    && echo "deb http://deb.debian.org/debian-security bookworm-security main contrib non-free" >> /etc/apt/sources.list \
    # Import Debian archive keys to resolve GPG errors
    # Keys for Debian Bookworm main, updates, and security repositories
    && apt-key adv --keyserver keyserver.ubuntu.com --recv-keys 0E98404D386FA1D9 \
    && apt-key adv --keyserver keyserver.ubuntu.com --recv-keys 6ED0E7B82643E131 \
    && apt-key adv --keyserver keyserver.ubuntu.com --recv-keys F8D2585B8783D481 \
    && apt-key adv --keyserver keyserver.ubuntu.com --recv-keys 54404762BBB6E853 \
    && apt-key adv --keyserver keyserver.ubuntu.com --recv-keys BDE6D2B9216EC7A8 \
    && apt-get update -qqy \
    # Attempt to fix any broken packages or held packages
    && apt-get update --fix-missing -qqy \
    && DEBIAN_FRONTEND=noninteractive apt-get -f install -qqy \
    && DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -qqy

# Install essential packages for both Firefox and Chrome in headless mode
RUN DEBIAN_FRONTEND=noninteractive apt-get install -qqy --no-install-recommends \
    # Common utilities for downloading, extracting, and system info
    wget \
    curl \
    bzip2 \
    unzip \
    xvfb \
    xz-utils \
    apt-utils \
    procps \
    strace \
    # Core system libraries for both browsers
    ca-certificates \
    gnupg2 \
    libxtst6 \
    libnss3 \
    libxss1 \
    libgbm1 \
    libgl1 \
    libfontconfig1 \
    libfreetype6 \
    libjpeg-turbo8 \
    libpng16-16 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxrender1 \
    libharfbuzz0b \
    libevent-2.1-7 \
    libffi8 \
    dbus-x11 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libx11-xcb1 \
    libdrm2 \
    libglib2.0-0 \
    libsoup2.4-1 \
    fonts-liberation \
    fonts-dejavu \
    libdbus-1-3 \
    libegl1 \
    libxcb-xinput0 \
    libpulse0 \
    libvulkan1 \
    libnss3-tools \
    locales \
    tzdata \
    xauth \
    # Firefox specific audio packages (if needed for libxul.so)
    libasound2 \
    libasound2-data \
    libasound2-plugins \
    alsa-utils \
    # Chrome specific dependencies
    libpci3 \
    # For libgconf-2-4, which is often problematic, we'll try manual install later if needed
    # (Removed from this main install block to avoid conflicts)
    && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Run ldconfig to ensure library paths are updated
RUN ldconfig \
    && echo "Verifying libasound.so.2 presence:" \
    && find / -name libasound.so.2 2>/dev/null || echo "libasound.so.2 not found after install!"

# Manually install libasound2t64 (as suggested by user, if apt-get fails)
# This block is kept as a fallback if the main apt-get install for libasound2 fails to provide libasound.so.2
RUN wget -q http://mirrors.edge.kernel.org/ubuntu/pool/main/a/alsa-lib/libasound2_1.2.4-1.1ubuntu2_amd64.deb -O libasound2t64.deb || true && \
    if [ -f libasound2t64.deb ]; then \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y ./libasound2t64.deb || true; \
    fi && \
    rm -f ./*.deb

# Manually install libgconf-2-4 and its dependencies (as suggested by user, if apt-get fails)
# This block is kept as a fallback for an older, often problematic dependency
RUN wget -q http://mirrors.edge.kernel.org/ubuntu/pool/universe/g/gconf/gconf2-common_3.2.6-7ubuntu2_all.deb || true && \
    wget -q http://mirrors.edge.kernel.org/ubuntu/pool/universe/g/gconf/libgconf-2-4_3.2.6-7ubuntu2_amd64.deb || true && \
    if [ -f gconf2-common_3.2.6-7ubuntu2_all.deb ] && [ -f libgconf-2-4_3.2.6-7ubuntu2_amd64.deb ]; then \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y ./gconf2-common_3.2.6-7ubuntu2_all.deb ./libgconf-2-4_3.2.6-7ubuntu2_amd64.deb || true; \
    fi && \
    rm -f ./*.deb

# Install Firefox
RUN wget -q -O /tmp/firefox.tar.xz "https://ftp.mozilla.org/pub/firefox/releases/${FIREFOX_VERSION}/linux-x86_64/en-US/firefox-${FIREFOX_VERSION}.tar.xz" \
    && tar -xJf /tmp/firefox.tar.xz -C /opt/ \
    && rm /tmp/firefox.tar.xz \
    && ln -s /opt/firefox/firefox /usr/bin/firefox \
    && chmod -R 755 /opt/firefox \
    && echo "Verifying Firefox dependencies after installation:" \
    && ldd /opt/firefox/libxul.so | grep asound || echo "libasound.so.2 not found in ldd output!"

# Install Geckodriver
RUN wget -q -O /tmp/geckodriver.tar.gz "https://github.com/mozilla/geckodriver/releases/download/v${GECKODRIVER_VERSION}/geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz" \
    && tar -xzf /tmp/geckodriver.tar.gz -C /tmp/ \
    && mv /tmp/geckodriver /usr/local/bin/geckodriver \
    && rm /tmp/geckodriver.tar.gz \
    && chmod +x /usr/local/bin/geckodriver

# Install Chrome
RUN apt-get update -qqy \
    && apt-get install -qqy wget curl gnupg unzip ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update -qqy \
    && apt-get install -qqy google-chrome-stable=${CHROME_VERSION} \
    && rm /etc/apt/sources.list.d/google-chrome.list \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
    && sed -i 's|"$HERE/chrome"|"$HERE/chrome" --no-sandbox|g' /opt/google/chrome/google-chrome

# Install ChromeDriver
RUN wget -q -O /tmp/chromedriver.zip https://storage.googleapis.com/chrome-for-testing-public/${CHROME_DRIVER_VERSION}/linux64/chromedriver-linux64.zip \
    && unzip /tmp/chromedriver.zip -d /opt \
    && rm /tmp/chromedriver.zip \
    && ln -s /opt/chromedriver-linux64/chromedriver /usr/bin/chromedriver

# Create common cache directories and set permissions
RUN mkdir -p /tmp/.mozilla /tmp/.cache/google-chrome \
    && chmod -R 777 /tmp/.mozilla /tmp/.cache/google-chrome

# Create Firefox preferences to improve stability in headless mode
RUN mkdir -p /etc/firefox && \
    echo 'pref("gfx.x11-egl.force-enabled", false);' >> /etc/firefox/syspref.js && \
    echo 'pref("widget.use-xdg-desktop-portal", false);' >> /etc/firefox/syspref.js && \
    echo 'pref("browser.tabs.remote.autostart", false);' >> /etc/firefox/syspref.js && \
    echo 'pref("layers.acceleration.disabled", true);' >> /etc/firefox/syspref.js

# Create scripts as root before switching to appuser
# Create a script to run tests with Xvfb
RUN echo '#!/bin/bash\nxvfb-run -a --server-args="-screen 0 1920x1080x24" "$@"' > /usr/local/bin/xvfb-run-safe \
    && chmod +x /usr/local/bin/xvfb-run-safe

# Create a more robust Xvfb startup script
RUN echo '#!/bin/bash\n\
    # Start Xvfb\n\
    Xvfb :99 -screen 0 1920x1080x24 -ac &\n\
    XVFB_PID=$!\n\
    \n\
    # Wait for Xvfb to be ready\n\
    sleep 5\n\
    \n\
    # Run the command\n\
    "$@"\n\
    EXIT_CODE=$?\n\
    \n\
    # Kill Xvfb\n\
    kill $XVFB_PID\n\
    \n\
    # Return the command exit code\n\
    exit $EXIT_CODE' > /usr/local/bin/with-xvfb \
    && chmod +x /usr/local/bin/with-xvfb

# Copy the test runner scripts
COPY run-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

COPY harness-run-tests.sh /usr/local/bin/harness-run-tests.sh
RUN chmod +x /usr/local/bin/harness-run-tests.sh

# Environment Variables
# Set the paths to the Firefox binary and Geckodriver binary
ENV FIREFOX_BIN=/usr/bin/firefox
ENV GECKODRIVER_BIN=/usr/local/bin/geckodriver
# Set the paths to the Chrome binary and ChromeDriver binary
ENV CHROME_BIN=/usr/bin/google-chrome
ENV CHROMEDRIVER_BIN=/usr/bin/chromedriver

# Explicitly enable headless mode for Firefox
ENV MOZ_HEADLESS=1
# Set display for Xvfb (if needed)
ENV DISPLAY=:99
# Set Firefox preferences for Docker environment
ENV MOZ_FORCE_DISABLE_E10S=1
ENV MOZ_DISABLE_CONTENT_SANDBOX=1
ENV MOZ_DISABLE_GMP_SANDBOX=1
ENV MOZ_DISABLE_RDD_SANDBOX=1
ENV MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
ENV MOZ_DISABLE_UTILITY_SANDBOX=1
# Disable Firefox crash reporter in headless mode
ENV MOZ_CRASHREPORTER_DISABLE=1
# Set locale variables for better compatibility
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
# Disable hardware acceleration for Firefox
ENV MOZ_WEBRENDER=0
ENV MOZ_ACCELERATED=0

# Configure library paths for Firefox
RUN mkdir -p /etc/ld.so.conf.d/ && \
    echo "/usr/lib/x86_64-linux-gnu" > /etc/ld.so.conf.d/firefox-libs.conf && \
    echo "/usr/lib" >> /etc/ld.so.conf.d/firefox-libs.conf && \
    ldconfig && \
    # Verify libasound.so.2 is in the library path
    echo "Verifying libasound.so.2 in library path:" && \
    ldconfig -p | grep libasound.so.2

# Explicitly set LD_LIBRARY_PATH
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/pulseaudio:/usr/lib:${LD_LIBRARY_PATH}
# Set a robust PATH
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

# Create non-root user
RUN useradd -m appuser
USER appuser
WORKDIR /home/appuser

# Expose the default port for Geckodriver (and ChromeDriver, if used in standalone mode)
EXPOSE 4444

# No CMD directive - Harness will execute mvn clean test directly
